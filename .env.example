# Copy to .env and edit. Every variable is optional; defaults are shown.
# Anything chosen in the studio's Model Settings page overrides these.
# Never commit .env: it is in .gitignore.

# --- Lyrics, storyboards (text) ----------------------------------------------
# none | pollinations | ollama | openai | openai_compatible | mock
#   pollinations      free hosted LLM, no key, rate-limited; prompts leave your machine
#   ollama            local; install Ollama and run: ollama pull llama3.2
#   mock              labelled placeholder text, for UI development only
TROLL_LLM_PROVIDER=none
# TROLL_LLM_MODEL=llama3.2
# TROLL_LLM_BASE_URL=http://localhost:11434/v1
# TROLL_LLM_API_KEY=
# TROLL_LLM_TIMEOUT=120
# TROLL_LLM_JSON_MODE=false

# --- Beats and music ---------------------------------------------------------
# procedural | musicgen | acestep | elevenlabs_music | none
#   procedural        built-in NumPy synthesizer (not AI), exact BPM, always available
#   musicgen          local AI, needs torch + transformers and downloaded weights:
#                     python scripts/download_models.py musicgen   (CC-BY-NC: non-commercial)
#   acestep           ACE-Step 1.5 API server you run (free, local GPU). SINGS the lyrics:
#                     every roast becomes a full song with AI vocals. Default URL below.
#   elevenlabs_music  hosted, needs an API key on a PAID ElevenLabs plan (the Music API is
#                     not on the free plan). SINGS the lyrics. Every song uses credits.
#                     Models: music_v2_5 (default, best at fast rap), music_v2, music_v1.
# With a provider that sings, the troll pipeline sends the lyrics to it and gets one
# finished song back. With the others, vocals are spoken by the voice provider below.
TROLL_MUSIC_PROVIDER=procedural
# TROLL_MUSIC_MODEL=facebook/musicgen-small
# TROLL_MUSIC_BASE_URL=http://localhost:8001
# TROLL_MUSIC_API_KEY=

# --- Vocals and voice ----------------------------------------------------------
# system_tts | openai_speech | elevenlabs | chatterbox | none
#   system_tts        your OS speech engine via pyttsx3 (not AI; Linux needs espeak-ng)
#   openai_speech     any /audio/speech server (OpenAI, Kokoro-FastAPI, LocalAI)
#   elevenlabs        hosted speech + consented voice cloning + voice conversion
#   chatterbox        local zero-shot cloning (pip install chatterbox-tts, GPU recommended)
# None of these sing. Lines are placed on the beat as rhythmic speech.
TROLL_VOICE_PROVIDER=system_tts
# TROLL_VOICE_MODEL=
# TROLL_VOICE_BASE_URL=
# TROLL_VOICE_API_KEY=

# --- Artwork and video scenes (images) -------------------------------------------
# typographic | pollinations | openai_images | comfyui | none
#   typographic       built-in title cards drawn with Pillow (not AI)
#   pollinations      free hosted image models, no key, about 1 image / 45 s per IP
#   comfyui           your local ComfyUI; set TROLL_IMAGE_MODEL to a checkpoint file name
TROLL_IMAGE_PROVIDER=typographic
# TROLL_IMAGE_MODEL=flux
# TROLL_IMAGE_BASE_URL=
# TROLL_IMAGE_API_KEY=

# --- Backend -----------------------------------------------------------------
# SQLite by default. PostgreSQL: postgresql+psycopg://user:password@host:5432/troll
# (install the extra first: pip install -e ".[postgres]")
TROLL_DATABASE_URL=sqlite:///./data/troll.db
TROLL_STORAGE_DIR=./data/storage
TROLL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TROLL_JOB_WORKERS=2
# Refuse new jobs (HTTP 429) once this many are queued or running.
# TROLL_MAX_WAITING_JOBS=20
TROLL_MAX_UPLOAD_MB=50
# FFmpeg: PATH first, then the binary bundled with imageio-ffmpeg. Set to force one.
# TROLL_FFMPEG_PATH=
# When set, every API call needs "Authorization: Bearer <key>" (enter it in Model Settings).
# TROLL_API_KEY=

# --- SDK client ----------------------------------------------------------------
# Read by TrollMusic(api_key=..., base_url=...) when the arguments are omitted.
# TROLL_API_URL=http://localhost:8000

# --- Web app (set in apps/web/.env.local, read at build time) ----------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
